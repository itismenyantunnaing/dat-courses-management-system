# Copy this file to .env (same folder) and fill in your own values.
# .env is gitignored on purpose — it holds real secrets, never commit it.
# Used by docker-compose.yml when running `docker compose up`.

# Server
# - Local Docker testing on your own machine: SERVER_IP=localhost
# - Real deployment: SERVER_IP=<the server's public IP or domain>
SERVER_IP=insert_wifi_ipv4Address

# Database
DB_ROOT_PASSWORD=change_me
DB_NAME=your_db_name
DB_USER=your_db_user
DB_PASSWORD=change_me

# ── Backend ───────────────────────────────────────────────────────
JWT_SECRET=change_me_to_a_long_random_string
MAIL_HOST=smtp.office365.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
