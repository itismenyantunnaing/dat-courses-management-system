# Copy this file to .env.local (same folder) and adjust if needed.
# .env.local is gitignored on purpose, never commit it.
#
# Points the frontend at your locally-running backend
# (mvn spring-boot:run defaults to port 8080).
NEXT_PUBLIC_API_URL=http://insert_wifi_ipv4Address:8080
# Optional override. If omitted, frontend auto-derives ws endpoint from
# NEXT_PUBLIC_API_URL by appending /ws.
# NEXT_PUBLIC_WS_URL=http://insert_wifi_ipv4Address:8080/ws
